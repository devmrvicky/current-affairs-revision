# ─── Supabase (auth, sync, admin analytics) ───────────────────────────────────
# Create a project at https://supabase.com/dashboard, then:
#   Project Settings → API → Project URL / anon public key
# The anon key is safe to expose client-side — Row Level Security in the
# database is what actually controls access, not key secrecy.
# Apply schema with: supabase db push (see supabase/migrations/)

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── Firebase Push Notifications (optional) ───────────────────────────────────
# Create a Firebase project at https://console.firebase.google.com/
# Enable Cloud Messaging, get Web Push Certificate (VAPID key) from:
#   Project Settings → Cloud Messaging → Web Push certificates → Key pair
# Copy this file to .env and fill in your values.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# ─── App Config (optional overrides) ─────────────────────────────────────────
# VITE_APP_NAME=Current Affairs Revision
